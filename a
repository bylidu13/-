-- 读取饰品数据
local function readTrinket(item)
    if not item then return nil end
    
    return {
        Name = item.Name or "Unknown",
        Grade = item:GetAttribute("Grade") or 0,
        Type = item:GetAttribute("Type") or "Unknown",
        Modifiers = item:GetAttribute("Modifiers") or {},
        IsEquipped = item:GetAttribute("IS_EQUIPPED") or false,
    }
end

-- 获取所有饰品
local function getTrinkets()
    local player = getPlayer()
    if not player then return {} end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return {} end
    
    local trinkets = {}
    for _, item in ipairs(backpack:GetChildren()) do
        if item:GetAttribute("Type") then
            local trinket = readTrinket(item)
            if trinket then
                table.insert(trinkets, trinket)
            end
        end
    end
    
    return trinkets
end

