-- ============================================================
-- 主 Farming 循环
-- ============================================================

local isFarming = false
local stopFarming = false

local function farmDungeon()
    if stopFarming then return end
    if isFarming then return end
    isFarming = true
    
    local success, err = pcall(function()
        local player = getPlayer()
        if not player then return end
        
        local character = getCharacter()
        if not character then
            setStatus("Waiting for character...", Color3.fromRGB(255, 200, 100))
            waitFor(function() return getCharacter() ~= nil end, 10)
            character = getCharacter()
            if not character then return end
        end
        
        setDifficulty(Config.Difficulty)
        
        local energy = getEnergy()
        if energy < 1 then
            setStatus("Not enough Energy", Color3.fromRGB(255, 100, 100))
            setDetail("Energy: " .. tostring(energy))
            task.wait(2)
            return
        end
        
        setStatus("Selecting weapon...", Color3.fromRGB(255, 200, 100))
        switchWeapon()
        
        setStatus("Finding pad...", Color3.fromRGB(255, 200, 100))
        local pad = findNearestPad()
        if not pad then
            setStatus("No pad found!", Color3.fromRGB(255, 100, 100))
            task.wait(2)
            return
        end
        
        setStatus("Entering pad...", Color3.fromRGB(255, 200, 100))
        setDetail("Moving to pad")
        enterPad(pad)
        
        setStatus("Waiting for dungeon...", Color3.fromRGB(255, 200, 100))
        setDetail("Waiting for dungeon to start...")
        setProgress(0.3)
        
        if not waitForDungeonStart(30) then
            setStatus("Dungeon timeout", Color3.fromRGB(255, 100, 100))
            setDetail("Dungeon didn't start")
            task.wait(2)
            return
        end
        
        setStatus("⚔️ Farming Dungeon", Color3.fromRGB(100, 255, 100))
        setProgress(0.5)
        
        local startTime = tick()
        local maxDuration = 600
        
        while isInDungeon() and tick() - startTime < maxDuration and not stopFarming do
            local enemy = findNearestEnemy()
            if enemy then
                setDetail("Attacking enemy...")
                attackEnemy(enemy)
            else
                setDetail("Searching for enemies...")
                moveToCenter()
            end
            
            local currentEnergy = getEnergy()
            if currentEnergy < 1 then
                setStatus("Out of energy!", Color3.fromRGB(255, 100, 100))
                setDetail("Energy depleted")
                task.wait(1)
                break
            end
            
            task.wait(0.1)
        end
        
        if stopFarming then
            setStatus("Stopped", Color3.fromRGB(255, 200, 100))
            setDetail("Farming stopped")
        else
            setStatus("✅ Dungeon Complete", Color3.fromRGB(100, 255, 100))
            setDetail("Farming session finished")
            setProgress(1)
            
            if Config.WebhookUrl and Config.WebhookUrl ~= "" then
                pcall(sendTrinketsReport)
            end
        end
        
        task.wait(2)
    end)
    
    if not success then
        warn("[BananaCatHub] Farming error: " .. tostring(err))
        setStatus("Error", Color3.fromRGB(255, 50, 50))
        setDetail(tostring(err):sub(1, 50))
        task.wait(3)
    end
    
    isFarming = false
end

-- ============================================================
-- 主循环
-- ============================================================

local function mainLoop()
    while not stopFarming do
        if not isFarming then
            safeCall(farmDungeon)
        end
        task.wait(3)
    end
end

-- ============================================================
-- Webhook 循环
-- ============================================================

local function webhookLoop()
    while not stopFarming do
        if Config.WebhookUrl and Config.WebhookUrl ~= "" then
            pcall(sendTrinketsReport)
        end
        task.wait(Config.WebhookInterval or 300)
    end
end

-- ============================================================
-- 启动函数
-- ============================================================

local function start()
    createStatusUI()
    setStatus("Starting...", Color3.fromRGB(255, 200, 100))
    setDetail("Initializing farming bot")
    setProgress(0.1)
    
    setDetail("Waiting for game...")
    waitFor(function() return game:IsLoaded() end, 60)
    
    setDetail("Waiting for player...")
    waitFor(function() 
        local player = getPlayer()
        return player and player.Character
    end, 30)
    
    setProgress(0.3)
    setStatus("Ready", Color3.fromRGB(100, 255, 100))
    setDetail("Starting farming loop...")
    setProgress(0.5)
    
    task.spawn(mainLoop)
    
    if Config.WebhookUrl and Config.WebhookUrl ~= "" then
        task.spawn(webhookLoop)
    end
    
    setStatus("🟢 Running", Color3.fromRGB(100, 255, 100))
    setDetail("Farming dungeons...")
    setProgress(1)
    
    print("[BananaCatHub] Started successfully!")
    print("[BananaCatHub] Difficulty:", Config.Difficulty)
    print("[BananaCatHub] MinGradeToLock:", Config.MinGradeToLock)
end

local function stop()
    stopFarming = true
    if statusUI then
        statusUI:SetStatus("Stopped", Color3.fromRGB(255, 200, 100))
        statusUI:SetDetail("Farming stopped by user")
    end
    print("[BananaCatHub] Stopped")
end

local function destroy()
    stopFarming = true
    isFarming = false
    if statusUI then
        statusUI:Destroy()
    end
    print("[BananaCatHub] Destroyed")
end

-- ============================================================
-- 自动启动
-- ============================================================

if Config.AutoLoad then
    task.spawn(start)
end

-- ============================================================
-- 导出
-- ============================================================

return {
    Config = Config,
    Start = start,
    Stop = stop,
    Destroy = destroy,
    GetTrinkets = getTrinkets,
    GetEnergy = getEnergy,
    GetWeapons = getWeapons,
    GetBestWeapon = getBestWeapon,
    FarmDungeon = farmDungeon,
    SetDifficulty = setDifficulty,
}
