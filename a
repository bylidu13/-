-- ============================================================
-- 工具函数
-- ============================================================

local function safeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("[BananaCatHub] Error: " .. tostring(result))
        return nil
    end
    return result
end

local function waitFor(condition, timeout, interval)
    timeout = timeout or 30
    interval = interval or 0.1
    local start = tick()
    while tick() - start < timeout do
        if condition() then
            return true
        end
        task.wait(interval)
    end
    return false
end

-- ============================================================
-- 游戏对象获取
-- ============================================================

local function getPlayer()
    return game:GetService("Players").LocalPlayer
end

local function getCharacter()
    local player = getPlayer()
    if not player then return nil end
    return player.Character
end

local function getHumanoid()
    local character = getCharacter()
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getHumanoidRootPart()
    local character = getCharacter()
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getReplicatedStorage()
    return game:GetService("ReplicatedStorage")
end

-- ============================================================
-- 武器检测系统
-- ============================================================

local function detectWeaponType(item)
    if not item then return "Unknown" end
    
    local name = item.Name:lower()
    local weaponType = item:GetAttribute("WeaponType")
    
    if weaponType and weaponType ~= "" then
        local wt = weaponType:lower()
        if wt:find("sword") or wt:find("blade") then return "Sword"
        elseif wt:find("fruit") or wt:find("blox") then return "Fruit"
        elseif wt:find("lifesteal") or wt:find("life") then return "Lifesteal"
        elseif wt:find("hyper") then return "Hyper"
        elseif wt:find("melee") or wt:find("fist") then return "Melee"
        end
    end
    
    if name:find("sword") or name:find("blade") or name:find("katana") then
        return "Sword"
    elseif name:find("fruit") or name:find("blox") or name:find("demon") then
        return "Fruit"
    elseif name:find("lifesteal") or name:find("life steal") or name:find("leech") then
        return "Lifesteal"
    elseif name:find("hyper") or name:find("super") then
        return "Hyper"
    else
        return "Melee"
    end
end

local function getM1Speed(item)
    if not item then return 0 end
    
    local speed = item:GetAttribute("M1Speed") or item:GetAttribute("m1Speed") or 0
    if speed == 0 then
        local weaponType = detectWeaponType(item)
        local estimates = {
            Hyper = 2.0,
            Fruit = 1.8,
            Sword = 1.5,
            Lifesteal = 1.3,
            Melee = 1.0,
        }
        speed = estimates[weaponType] or 1.0
    end
    return speed
end

local function getWeapons()
    local player = getPlayer()
    if not player then return {} end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return {} end
    
    local weapons = {}
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(weapons, item)
        end
    end
    
    return weapons
end

local function getBestWeapon()
    local weapons = getWeapons()
    if #weapons == 0 then return nil end
    
    local best = nil
    local bestScore = -1
    
    local typeScores = {
        Hyper = 100,
        Fruit = 80,
        Sword = 60,
        Lifesteal = 50,
        Melee = 30,
    }
    
    for _, weapon in ipairs(weapons) do
        local weaponType = detectWeaponType(weapon)
        local m1Speed = getM1Speed(weapon)
        local typeScore = typeScores[weaponType] or 10
        local score = m1Speed * 50 + typeScore
        
        if weapon.Parent == getCharacter() then
            score = score + 50
        end
        
        if score > bestScore then
            bestScore = score
            best = weapon
        end
    end
    
    return best
end

local function equipWeapon(weapon)
    if not weapon then return false end
    
    local player = getPlayer()
    local character = getCharacter()
    if not character then return false end
    
    if weapon.Parent == character then
        return true
    end
    
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = player.Backpack
        end
    end
    
    weapon.Parent = character
    task.wait(0.3)
    return true
end

local function switchWeapon()
    local best = getBestWeapon()
    if best then
        return equipWeapon(best)
    end
    return false
end

-- ============================================================
-- 能量系统
-- ============================================================

local function getEnergy()
    local character = getCharacter()
    if not character then return 0 end
    
    local energy = character:FindFirstChild("RaceEnergy")
    if energy and energy.Value then
        return energy.Value
    end
    
    local replicatedStorage = getReplicatedStorage()
    if replicatedStorage then
        local modules = replicatedStorage:FindFirstChild("Modules")
        if modules then
            local net = modules:FindFirstChild("Net")
            if net then
                local dungeonNPC = net:FindFirstChild("RF/DungeonNPCNetworkFunction")
                if dungeonNPC and dungeonNPC.InvokeServer then
                    local success, result = pcall(dungeonNPC.InvokeServer, dungeonNPC, "GetDungeonEnergy")
                    if success and result then
                        return result
                    end
                end
            end
        end
    end
    
    return 0
end

-- ============================================================
-- Pad 系统
-- ============================================================

local function findPads()
    local workspace = game:GetService("Workspace")
    local pads = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("pad") or name:find("platform") or name:find("teleport") then
                if obj.CanTouch ~= false then
                    table.insert(pads, obj)
                end
            end
        end
    end
    
    return pads
end

local function findNearestPad()
    local rootPart = getHumanoidRootPart()
    if not rootPart then return nil end
    
    local pads = findPads()
    if #pads == 0 then return nil end
    
    table.sort(pads, function(a, b)
        local distA = (a.Position - rootPart.Position).Magnitude
        local distB = (b.Position - rootPart.Position).Magnitude
        return distA < distB
    end)
    
    return pads[1]
end

local function enterPad(pad)
    if not pad then return false end
    
    local rootPart = getHumanoidRootPart()
    if not rootPart then return false end
    
    rootPart.CFrame = pad.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.3)
    
    local function fireTouch(part)
        if firetouchinterest then
            firetouchinterest(rootPart, part, 0)
            task.wait(0.05)
            firetouchinterest(rootPart, part, 1)
        end
    end
    
    for _, part in ipairs(pad:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(fireTouch, part)
        end
    end
    
    return true
end

-- ============================================================
-- 地牢检测
-- ============================================================

local function isInDungeon()
    local character = getCharacter()
    if not character then return false end
    
    if character:FindFirstChild("DungeonLua") then
        return true
    end
    
    local workspace = game:GetService("Workspace")
    if workspace:FindFirstChild("Dungeon") then
        return true
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("enemy") then
            return true
        end
    end
    
    return false
end

local function waitForDungeonStart(timeout)
    timeout = timeout or 30
    return waitFor(function()
        return isInDungeon()
    end, timeout)
end

-- ============================================================
-- 敌人系统
-- ============================================================

local function findEnemies()
    local workspace = game:GetService("Workspace")
    local enemies = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("enemy") or name:find("mob") or name:find("zombie") or 
               name:find("skeleton") or name:find("boss") or name:find("monster") then
                local parent = obj.Parent
                if parent then
                    local humanoid = parent:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        table.insert(enemies, {
                            Part = obj,
                            Humanoid = humanoid,
                            Position = obj.Position
                        })
                    end
                end
            end
        end
    end
    
    return enemies
end

local function findNearestEnemy()
    local rootPart = getHumanoidRootPart()
    if not rootPart then return nil end
    
    local enemies = findEnemies()
    if #enemies == 0 then return nil end
    
    table.sort(enemies, function(a, b)
        local distA = (a.Position - rootPart.Position).Magnitude
        local distB = (b.Position - rootPart.Position).Magnitude
        return distA < distB
    end)
    
    return enemies[1]
end

local function attackEnemy(enemyData)
    if not enemyData then return false end
    
    local character = getCharacter()
    local rootPart = getHumanoidRootPart()
    if not character or not rootPart then return false end
    
    local enemyPart = enemyData.Part
    if not enemyPart then return false end
    
    local direction = (enemyPart.Position - rootPart.Position).Unit
    rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + direction * 10)
    
    local replicatedStorage = getReplicatedStorage()
    if replicatedStorage then
        local remotes = replicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local registerHit = remotes:FindFirstChild("RE/RegisterHit")
            if registerHit and registerHit.FireServer then
                pcall(registerHit.FireServer, registerHit, enemyPart)
            end
            
            local registerAttack = remotes:FindFirstChild("RE/RegisterAttack")
            if registerAttack and registerAttack.FireServer then
                pcall(registerAttack.FireServer, registerAttack)
            end
            
            local leftClick = remotes:FindFirstChild("LeftClickRemote")
            if leftClick and leftClick.FireServer then
                pcall(leftClick.FireServer, leftClick)
            end
        end
    end
    
    return true
end

-- ============================================================
-- 移动系统
-- ============================================================

local function moveTo(position)
    local rootPart = getHumanoidRootPart()
    if not rootPart then return false end
    
    rootPart.CFrame = CFrame.new(position)
    task.wait(0.1)
    return true
end

local function moveToCenter()
    return moveTo(Vector3.new(0, 0, 0))
end

-- ============================================================
-- 饰品/戒指系统
-- ============================================================

local function readTrinket(item)
    if not item then return nil end
    
    return {
        Name = item.Name or "Unknown",
        Grade = item:GetAttribute("Grade") or 0,
        Type = item:GetAttribute("Type") or "Unknown",
        Modifiers = item:GetAttribute("Modifiers") or {},
        IsEquipped = item:GetAttribute("IS_EQUIPPED") or false,
    }
end

local function getTrinkets()
    local player = getPlayer()
    if not player then return {} end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return {} end
    
    local trinkets = {}
    for _, item in ipairs(backpack:GetChildren()) do
        if item:GetAttribute("Type") then
            local trinket = readTrinket(item)
            if trinket then
                table.insert(trinkets, trinket)
            end
        end
    end
    
    return trinkets
end

-- ============================================================
-- 难度设置
-- ============================================================

local function setDifficulty(difficulty)
    local replicatedStorage = getReplicatedStorage()
    if not replicatedStorage then return end
    
    local settings = replicatedStorage:FindFirstChild("DungeonSettingsChanged")
    if settings and settings.FireServer then
        pcall(settings.FireServer, settings, difficulty or Config.Difficulty)
    end
end

-- ============================================================
-- Webhook 系统
-- ============================================================

local function sendWebhook(data)
    if not Config.WebhookUrl or Config.WebhookUrl == "" then
        return
    end
    
    local success, err = pcall(function()
        local requestFunc = syn and syn.request or http and http.request or request
        if not requestFunc then return end
        
        requestFunc({
            Url = Config.WebhookUrl,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = game:GetService("HttpService"):JSONEncode(data)
        })
    end)
    
    return success
end

local function sendTrinketsReport()
    local trinkets = getTrinkets()
    if #trinkets == 0 then return end
    
    local player = getPlayer()
    local embed = {
        title = "Dungeon Trinket Report",
        color = 16763904,
        fields = {},
        footer = {
            text = "BananaCatHub AutoDungeon"
        }
    }
    
    for i, trinket in ipairs(trinkets) do
        if i > 25 then break end
        local modifiers = table.concat(trinket.Modifiers or {}, ", ")
        if modifiers == "" then modifiers = "None"
        
        table.insert(embed.fields, {
            name = trinket.Name,
            value = string.format("Grade: %d | Modifiers: %s", trinket.Grade or 0, modifiers),
            inline = true
        })
    end
    
    sendWebhook({
        username = player.Name,
        avatar_url = "https://img.ws.mms.shopee.co.id/id-11134233-7qul2-ljrdxepwm42j36",
        embeds = { embed }
    })
end

